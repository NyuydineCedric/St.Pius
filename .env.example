# Template for .env — copy it (`cp .env.example .env`) and fill in.
# Values here are the cloud / split frontend+API defaults. Never commit secrets.

# ─── Backend (Java, System.getenv in Main.java) ───────────────────────────
PORT=8080
BIND_HOST=0.0.0.0
# Unset = file storage under DATA_DIR. Set it and the backend switches to
# Postgres. From Supabase: Project Settings → Database → Connection string →
# URI → Session pooler. Paste verbatim; credentials are re-encoded for JDBC.
# DATABASE_URL=
# Max pooled database connections. Supabase's free tier allows few, and the
# web app and any desktop clients share that budget.
# DB_POOL_SIZE=8
# Concurrent request handler threads.
# HTTP_THREADS=16

# Supabase Storage — not read by the code yet; the photo migration will use
# these. The service-role key is server-side only, never a VITE_ var.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=student-photos
# CORS origin, only needed when the frontend is served from another host.
# ALLOWED_ORIGIN=https://your-frontend.example
DATA_DIR=/app/data

# First-boot admin. Only applied when the store has NO admin yet — it never
# overwrites an existing account. Leave unset in real deployments and let the
# school register the first account instead (that account becomes admin).
# BOOTSTRAP_ADMIN_NAME=Admin
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# /api/demo/seed key, sent as the X-Demo-Seed-Key header. Defaults to "demo".
# DEMO_SEED_KEY=change-me
# Enables /api/demo/seed, which ERASES every student, mark, teacher and class
# before loading sample data. The route is not registered unless this is 1.
# Leave unset in production — being an admin is not enough to call it.
# ALLOW_DEMO_SEED=1

# ─── Frontend (Vite build-time; only VITE_-prefixed keys reach the app) ───
# Leave unset for `npm run dev` — the Vite proxy forwards /api to :8080.
# VITE_API_BASE_URL=https://api.your-domain.example

# ─── Seed scripts (scripts/seed-*.mjs) ───────────────────────────────────
# API_BASE=http://127.0.0.1:8080
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ─── Licensing ────────────────────────────────────────────────────────────
# Ed25519-signed key issued by scripts/license.mjs. If unset, the app looks
# for license.key in the data directory. Without either, the app runs
# read-only: reads and backups work, writes return 402.
# LICENSE_KEY=
# Optional revocation check. Unset = offline signature verification only.
# LICENSE_SERVER_URL=

# ─── Desktop sync (offline-first) ─────────────────────────────────────────
# Set on a DESKTOP install so it keeps its own local data and syncs to the
# shared server. Leave unset on the server itself and on standalone installs.
# Electron normally supplies these from cloud-config.json.
# SYNC_SERVER_URL=https://your-backend.onrender.com
# SYNC_EMAIL=
# SYNC_PASSWORD=
