{
  "main": "electron/main.cjs",
  "name": "report-card",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "backend": "bash scripts/start-backend.sh",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:random-marks": "node scripts/seed-random-marks.mjs",
    "stage:backend": "bash scripts/stage-backend.sh",
    "dist": "npm run stage:backend && electron-builder"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.1",
    "tailwindcss": "^4.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.reportcard.app",
    "productName": "Report Card Management System",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "staging/backend",
        "to": "backend"
      },
      {
        "from": "jre",
        "to": "jre"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Education"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education"
    }
  }
}